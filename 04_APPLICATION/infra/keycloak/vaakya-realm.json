{
  "realm": "vaakya",
  "enabled": true,
  "displayName": "VAAKYA",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "hi"
  ],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "content_reviewer"
      },
      {
        "name": "operator"
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "clients": [
    {
      "clientId": "vaakya-web",
      "name": "VAAKYA web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${VAAKYA_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${VAAKYA_APP_URL}/api/auth/callback"
      ],
      "webOrigins": [
        "${VAAKYA_APP_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${VAAKYA_APP_URL}"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr"
      ],
      "protocolMappers": [
        {
          "name": "vaakya-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "vaakya-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "7f3d2a10-0001-4000-8000-00000000a001",
      "username": "demo-priya",
      "email": "demo-priya@vaakya.invalid",
      "emailVerified": true,
      "firstName": "Priya",
      "lastName": "(demo)",
      "enabled": true,
      "realmRoles": [
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${VAAKYA_DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "7f3d2a10-0002-4000-8000-00000000a002",
