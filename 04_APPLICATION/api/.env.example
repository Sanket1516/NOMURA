# Copy to .env for local development. Never commit real values.
VAAKYA_ENV=development
VAAKYA_DATABASE_URL=postgresql+psycopg://vaakya:CHANGE_ME@localhost:5432/vaakya
VAAKYA_OIDC_ISSUER=http://localhost:8080/realms/vaakya
# VAAKYA_OIDC_JWKS_URL=http://keycloak:8080/realms/vaakya/protocol/openid-connect/certs  # when the issuer URL is not reachable from the API
VAAKYA_OIDC_AUDIENCE=vaakya-api
VAAKYA_LOG_HMAC_KEY=CHANGE_ME_random_32_bytes
VAAKYA_CORS_ORIGINS=[]
